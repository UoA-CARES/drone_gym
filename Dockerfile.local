FROM ubuntu:22.04

SHELL ["/bin/bash", "-c"]

# --- ENVIRONMENT & CACHE SETUP ---
ENV HOME=/tmp
ENV GZ_VERSION=garden
ENV CARES_LOG_BASE_DIR=/workspace/output
ENV GZ_FUEL_CACHE_DIR=/tmp/gz/fuel
ENV GZ_IP=127.0.0.1
# Isolate host-networked Gazebo jobs from other local simulations by default.
ENV GZ_PARTITION=drone_sim
ENV LIBGL_ALWAYS_SOFTWARE=1
ENV MPLCONFIGDIR=/tmp/matplotlib_cache
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
# Headless OpenGL for cv2 and matplotlib (no display needed)
ENV MUJOCO_GL=egl
ENV PYOPENGL_PLATFORM=egl
ENV NVIDIA_DRIVER_CAPABILITIES=compute,graphics

ARG CARES_RL_REF=main

WORKDIR /drone_ws

# Pre-create writable runtime directories for non-root workers.
RUN mkdir -p /tmp/matplotlib_cache /tmp/gz/fuel /workspace/output /tmp/cares_output && \
    chmod -R 777 /tmp/matplotlib_cache /tmp/gz /workspace/output /tmp/cares_output

# Install core system and Python packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    gnupg \
    lsb-release \
    python3.10 \
    python3-pip \
    build-essential \
    libusb-1.0-0 \
    socat \
    wget \
    libgl1 \
    libglib2.0-0 \
    libegl1 \
    libgles2 \
    libosmesa6 \
    libglfw3 \
    libxrender1 \
    libxext6 \
    libsm6 \
    libx11-6 \
    libxrandr2 \
    libxinerama1 \
    libxcursor1 \
    libxi6 \
    libxxf86vm1 \
    ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# Install Gazebo Garden — SimManager shells out to `gz service` for teleports,
# goal markers, and boundary visuals (drone_gym/sim_manager.py).
RUN wget https://packages.osrfoundation.org/gazebo.gpg -O /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" > /etc/apt/sources.list.d/gazebo-stable.list && \
    apt-get update && apt-get install -y --no-install-recommends gz-garden && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip first: Ubuntu 22.04's stock pip (22.0.2) can't read cflib's PEP 621
# pyproject metadata and silently installs an empty package named "UNKNOWN".
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Install the CrazySim fork of cflib (sitl-release): its UDP driver is modified
# to speak the SITL firmware's protocol — stock bitcraze cflib hangs at
# _request_protocol_version() against the CrazySim firmware.
# Build this file from drone_gym/:
#   docker build -f Dockerfile.local -t cares:drone-local .
RUN git clone --branch sitl-release https://github.com/llanesc/crazyflie-lib-python.git /drone_ws/cflib_src && \
    SETUPTOOLS_SCM_PRETEND_VERSION=0.1.31 python3 -m pip install --no-cache-dir /drone_ws/cflib_src && \
    python3 -c "import cflib.crtp; print('cflib OK after cflib install')"

# Install CARES RL first so its pinned numpy==1.26.4 is set before drone_gym installs.
RUN python3 -m pip install --no-cache-dir pettingzoo && \
    git clone --branch ${CARES_RL_REF} https://github.com/UoA-CARES/cares_reinforcement_learning.git /opt/cares_reinforcement_learning && \
    cd /opt/cares_reinforcement_learning && \
    python3 -m pip install --no-cache-dir -e ".[gym]" && \
    python3 -c "import cflib.crtp; print('cflib OK after cares_rl install')"

# Copy drone_gym source and install (numpy>=1.21.0 already satisfied by cares_rl's 1.26.4).
COPY drone_gym    ./drone_gym/drone_gym
COPY requirements.txt ./drone_gym/requirements.txt
COPY setup.py     ./drone_gym/setup.py
COPY README.md    ./drone_gym/README.md

RUN python3 -m pip install --no-cache-dir -r ./drone_gym/requirements.txt && \
    python3 -m pip install --no-cache-dir -e ./drone_gym && \
    python3 -c "import cflib.crtp; print('cflib OK after drone_gym install')"

# Force reinstall versions known to work with cflib/CrazySim (mirrors setup.sh).
RUN python3 -m pip install --force-reinstall --no-cache-dir \
    pandas==2.3.3 \
    opencv-python==4.7.0.72 \
    "numpy>=1.20,<1.25" && \
    python3 -c "import cflib.crtp; print('cflib OK after force-reinstall')"

# Open workspace/runtime permissions for arbitrary non-root HPC runtime accounts.
RUN chmod -R a+rX /drone_ws /opt/cares_reinforcement_learning /usr/local/lib/python3.10/dist-packages && \
    chmod -R 777 /tmp/matplotlib_cache /tmp/gz /workspace/output /tmp/cares_output

RUN printf '%s\n' \
    '#!/usr/bin/env bash' \
    'set -e' \
    '' \
    'export CARES_LOG_BASE_DIR="${CARES_LOG_BASE_DIR:-/workspace/output}"' \
    'if ! mkdir -p "$CARES_LOG_BASE_DIR" 2>/dev/null || [ ! -w "$CARES_LOG_BASE_DIR" ]; then' \
    '  export CARES_LOG_BASE_DIR=/tmp/cares_output' \
    '  mkdir -p "$CARES_LOG_BASE_DIR"' \
    'fi' \
    '' \
    'exec "$@"' \
> /drone_entrypoint.sh && \
    chmod 755 /drone_entrypoint.sh

WORKDIR /drone_ws

ENTRYPOINT ["/drone_entrypoint.sh"]
CMD ["bash"]
